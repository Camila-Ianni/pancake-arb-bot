# =============================================================================
# POLYMARKET LATENCY ARBITRAGE BOT - CONFIGURATION
# =============================================================================
# Copia este archivo a .env y completa los valores antes de ejecutar.
# NUNCA commits .env con valores reales.
# =============================================================================

# -----------------------------------------------------------------------------
# WALLET & RPC CONFIGURATION
# -----------------------------------------------------------------------------
# Clave privada de la wallet (NUNCA compartirla, usar solo para signing offline)
PRIVATE_KEY=0x________________________

# RPC Endpoint privado (Alchemy/QuickNode recomendado para baja latencia)
# Usar siempre RPC privado - los públicos tienen rate limiting y mayor latencia
RPC_URL=https://polygon-mainnet.g.alchemy.com/v2/YOUR_API_KEY

# RPC URL alternativo para failover (opcional pero recomendado)
RPC_URL_FAILOVER=https://polygon-mainnet.g.alchemy.com/v2/YOUR_BACKUP_KEY

# Address de la wallet (derivada de PRIVATE_KEY, para verificación)
WALLET_ADDRESS=0x________________________

# -----------------------------------------------------------------------------
# POLYMARKET GAMMA API
# -----------------------------------------------------------------------------
# API Key para Gamma API (WebSockets)
# Obtener en: https://polymarket.com/settings/api
POLYMARKET_API_KEY=your_api_key_here

# Condition ID específico del mercado a operar
# Ejemplo: "¿Qué temperatura habrá en NYC el Jan 15?" -> ID único del mercado
CONDITION_ID=________________________

# Market ID(s) asociados al condition_id (puede haber múltiples outcomes)
# Separados por coma si son múltiples: market_id_1,market_id_2
MARKET_IDS=________________________

# -----------------------------------------------------------------------------
# WEATHER FEED CONFIGURATION
# -----------------------------------------------------------------------------
# API de datos climáticos (WeatherAPI.com recomendado para baja latencia)
# Obtener API key en: https://www.weatherapi.com/
# - Free plan: 60 calls/min (1 call/segundo)
# - Standard plan: 600 calls/min (10 calls/segundo)
# - Enterprise: 6000+ calls/min
WEATHER_API_KEY=your_weatherapi_key_here

# Coordenadas de la estación meteorológica de referencia
# Importante: deben coincidir con la definición del mercado en Polymarket
# Ejemplo NYC: 40.7128, -74.0060
# Ejemplo London: 51.5074, -0.1278
WEATHER_LAT=40.7128
WEATHER_LON=-74.0060

# Frecuencia de heartbeat en segundos (cuánto tiempo sin datos antes de alertar)
HEARTBEAT_TIMEOUT_SEC=5

# Intervalo de polling en segundos (ajustar según rate limit del plan)
# - Free plan: 1.0 (1 call/segundo)
# - Standard plan: 0.1-0.5 (10-2 calls/segundo)
# Más bajo = más latencia pero más riesgo de rate limit
WEATHER_POLL_INTERVAL=0.5

# -----------------------------------------------------------------------------
# TRADING PARAMETERS
# -----------------------------------------------------------------------------
# Tamaño de la apuesta en USD
BET_SIZE_USD=100

# ROI mínimo para ejecutar (decimal: 0.05 = 5%)
# Debe cubrir: gas_cost + slippage + buffer de riesgo
MIN_ROI_THRESHOLD=0.08

# Slippage máximo tolerado (decimal: 0.02 = 2%)
MAX_SLIPPAGE_TOLERANCE=0.02

# Gas price máximo en Gwei (protección contra spikes)
MAX_GAS_PRICE_GWEI=150

# Priority fee en Gwei para EIP-1559 (mayor = más prioridad)
PRIORITY_FEE_GWEI=2

# -----------------------------------------------------------------------------
# RISK MANAGEMENT
# -----------------------------------------------------------------------------
# Máximo de pérdidas consecutivas antes de activar circuit breaker
MAX_CONSECUTIVE_LOSSES=3

# Latencia máxima del feed en ms antes de detener operaciones
MAX_FEED_LATENCY_MS=500

# Máximo de intentos de transacción fallidos antes de pausa
MAX_FAILED_TRANSACTIONS=5

# Pausa del circuit breaker en segundos
CIRCUIT_BREAKER_COOLDOWN_SEC=300

# -----------------------------------------------------------------------------
# EXECUTION MODE
# -----------------------------------------------------------------------------
# DRY_RUN=true: Simula operaciones sin enviar transacciones reales
# DRY_RUN=false: Ejecución real con capital real (PELIGRO)
DRY_RUN=true

# Logging level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=DEBUG

# Ruta del archivo de logs (dejar vacío para stdout únicamente)
LOG_FILE_PATH=/var/log/polymarket-arb/bot.log

# -----------------------------------------------------------------------------
# NTP / TIME SYNCHRONIZATION
# -----------------------------------------------------------------------------
# Servidores NTP para sincronización (usar servidores de baja latencia)
NTP_SERVERS=pool.ntp.org,time.google.com,time.cloudflare.com

# Tolerancia de desvío de tiempo en ms (si el clock local se desvía más, alertar)
TIME_DRIFT_TOLERANCE_MS=50

# -----------------------------------------------------------------------------
# PERFORMANCE TUNING
# -----------------------------------------------------------------------------
# Tamaño del buffer de la queue entre módulos
QUEUE_MAX_SIZE=1000

# Timeout para operaciones de red en segundos
NETWORK_TIMEOUT_SEC=5

# Reintentos máximos para operaciones fallidas
MAX_RETRIES=3

# Delay entre reintentos en segundos (exponential backoff base)
RETRY_DELAY_SEC=0.1
