# ═════════════════════════════════════════════════════════════════════════════
# 🚀 ENTORNO GLOBAL DE OPERACIÓN (BSC PANCAKESWAP)
# ═════════════════════════════════════════════════════════════════════════════
DRY_RUN=false
LOG_LEVEL=INFO
LOG_FILE_PATH=pancakeswap_bot.log

# ═════════════════════════════════════════════════════════════════════════════
# 🌐 BLOCKCHAIN RPC NODES & WALLET PERSISTENCE (BNB CHAIN)
# ═════════════════════════════════════════════════════════════════════════════
BSC_RPC_URL=https://bsc-dataseed.binance.org/

# 🔐 CLAVES PRIVADAS DE METAMASK (Completá estos 2 campos con tus datos)
PRIVATE_KEY="COMPLETA_AQUI_TU_CLAVE_PRIVADA"
WALLET_ADDRESS="COMPLETA_AQUI_TU_WALLET"

# ═════════════════════════════════════════════════════════════════════════════
# 🎛️ SNIPER ENGINE / RISK MANAGEMENT & RISK PARAMETERS
# ═════════════════════════════════════════════════════════════════════════════
# Cantidad de BNB a apostar en cada ronda (ej. 0.005 BNB)
BET_AMOUNT_BNB=0.0005

MAX_CONSECUTIVE_LOSSES=3
MAX_FEED_LATENCY_MS=500
MAX_FAILED_TRANSACTIONS=5
circuit_breaker_cooldown_sec=300

# ═════════════════════════════════════════════════════════════════════════════
# ⚡ HIGH-FREQUENCY PERFORMANCE TUNING (ASYNCHRONOUS ENGINE)
# ═════════════════════════════════════════════════════════════════════════════
QUEUE_MAX_SIZE=2000
NETWORK_TIMEOUT_SEC=5
MAX_RETRIES=3
RETRY_DELAY_SEC=0.1